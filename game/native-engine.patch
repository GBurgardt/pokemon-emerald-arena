+static EWRAM_DATA u8 sArenaPartyChoice = 0;
+static void WaitForArenaPartyChoice(void)
+{
+    if (gMain.callback2 != BattleMainCB2 || gPaletteFade.active || gBattleControllerExecFlags)
+        return;
+    gActiveBattler = 0;
+    if (!sArenaPartyChoice)
+    {
+        BtlController_EmitChoosePokemon(B_COMM_TO_CONTROLLER, PARTY_ACTION_CHOOSE_MON,
+            PARTY_SIZE, ABILITY_NONE, gBattleStruct->battlerPartyOrders[0]);
+        MarkBattlerForControllerExec(0);
+        sArenaPartyChoice = 1;
+        return;
+    }
+    sArenaPartyChoice = 0;
+    if (gBattleBufferB[0][1] >= PARTY_SIZE)
+    {
+        gBattleMainFunc = HandleTurnActionSelectionState;
+        return;
+    }
+    UpdateBattlerPartyOrdersOnSwitch();
+    gCurrentTurnActionNumber = 0;
+    gBattlerByTurnOrder[0] = 0;
+    gBattlerByTurnOrder[1] = 1;
+    gActionsByTurnOrder[0] = B_ACTION_SWITCH;
+    gActionsByTurnOrder[1] = B_ACTION_NOTHING_FAINTED;
+    gActionsByTurnOrder[2] = B_ACTION_FINISHED;
+    gCurrentActionFuncId = B_ACTION_SWITCH;
+    gBattleResources->battleScriptsStack->size = 0;
+    gBattleMainFunc = RunTurnActionsFunctions;
+}
+
+static void WaitForRealtimeArenaReturn(void)
+{
+    extern const u8 BattleScript_RealtimeArenaFaint[];
+    if (gMain.callback2 != BattleMainCB2 || gPaletteFade.active)
+        return;
+    if (gRealtimeArenaRestoringFaint)
+    {
+        gRealtimeArenaRestoringFaint = FALSE;
+        gCurrentTurnActionNumber = 0;
+        gBattlerByTurnOrder[0] = gBattlerAttacker;
+        gBattlerByTurnOrder[1] = gBattlerTarget;
+        gActionsByTurnOrder[0] = B_ACTION_EXEC_SCRIPT;
+        gActionsByTurnOrder[1] = B_ACTION_NOTHING_FAINTED;
+        gActionsByTurnOrder[2] = B_ACTION_FINISHED;
+        gCurrentActionFuncId = B_ACTION_EXEC_SCRIPT;
+        gBattleResources->battleScriptsStack->size = 0;
+        gBattleStruct->faintedActionsState = 0;
+        gBattlescriptCurrInstr = BattleScript_RealtimeArenaFaint;
+        gBattleMainFunc = RunTurnActionsFunctions;
+    }
+    else if (gBattleTypeFlags & BATTLE_TYPE_TRAINER)
+    {
+        sArenaPartyChoice = 0;
+        gBattleMainFunc = WaitForArenaPartyChoice;
+    }
+    else
+        gBattleMainFunc = HandleTurnActionSelectionState;
+}
+
+void RealtimeArena_ResumeBattle(bool8 fainted)
+{
+    gBattleMainFunc = WaitForRealtimeArenaReturn;
+}
+
+void RealtimeArena_FinishCapture(void)
+{
+    // The arena already presented the catch and used the native party/PC API.
+    // Let Emerald own field callbacks, roaming flags and resource cleanup.
+    gBattleOutcome = B_OUTCOME_CAUGHT;
+    gCurrentActionFuncId = B_ACTION_FINISHED;
+    gBattleMainFunc = HandleEndTurn_FinishBattle;
+}
