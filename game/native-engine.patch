+// Bounded synchronous secondary effects. Burn delegates to the native status
+// eligibility routine; stat drops keep the native mutation and Shield Dust rule.
+// Bite's turn flinch becomes a brief interrupt in the real-time action layer.
+u8 RealtimeArena_ResolveSecondary(u8 attacker, u8 target, u16 move)
+{
+    const u8 *savedScript = gBattlescriptCurrInstr;
+    u8 result = 0;
+    u8 stat = move == MOVE_AURORA_BEAM ? STAT_ATK : move == MOVE_MUD_SLAP ? STAT_ACC : move == MOVE_MUD_SHOT || move == MOVE_BUBBLE || move == MOVE_ROCK_TOMB || move == MOVE_ICY_WIND ? STAT_SPEED
+        : move == MOVE_PSYCHIC || move == MOVE_SHADOW_BALL || move == MOVE_CRUNCH ? STAT_SPDEF : STAT_DEF;
+    u8 before = gBattleMons[target].statStages[stat];
+    // These self effects apply on a connected hit, including a KO.
+    if(move==MOVE_SUPERPOWER)
+    {
+        if(gBattleMons[attacker].statStages[STAT_ATK]>MIN_STAT_STAGE)gBattleMons[attacker].statStages[STAT_ATK]--;
+        if(gBattleMons[attacker].statStages[STAT_DEF]>MIN_STAT_STAGE)gBattleMons[attacker].statStages[STAT_DEF]--;
+    }
+    if(move==MOVE_METEOR_MASH && Random()%100<gBattleMoves[move].secondaryEffectChance
+       &&gBattleMons[attacker].statStages[STAT_ATK]<MAX_STAT_STAGE)gBattleMons[attacker].statStages[STAT_ATK]++;
+    if (!gBattleMons[target].hp) return 0;
+    if ((gBattleMoves[move].effect == EFFECT_BURN_HIT || move == MOVE_BLAZE_KICK || move == MOVE_SACRED_FIRE)
+        && Random()%100 < gBattleMoves[move].secondaryEffectChance)
+    {
+        u8 scratch[2]={0},oldEffect=gBattleCommunication[MOVE_EFFECT_BYTE];
+        u8 oldBattler=gEffectBattler,oldScripting=gBattleScripting.battler;
+        u32 oldStatus=gBattleMons[target].status1;
+        gBattlerAttacker=attacker;gBattlerTarget=target;gCurrentMove=move;
+        gBattlescriptCurrInstr=scratch;
+        gBattleCommunication[MOVE_EFFECT_BYTE]=MOVE_EFFECT_BURN;
+        sArenaApplyingBurn=TRUE;
+        SetMoveEffect(FALSE,0);
+        sArenaApplyingBurn=FALSE;
+        gBattleCommunication[MOVE_EFFECT_BYTE]=oldEffect;
+        gEffectBattler=oldBattler;gBattleScripting.battler=oldScripting;
+        gBattlescriptCurrInstr=savedScript;
+        if(gBattleMons[target].status1!=oldStatus)
+        {
+            SetMonData(target?&gEnemyParty[gBattlerPartyIndexes[target]]:&gPlayerParty[gBattlerPartyIndexes[target]],
+                       MON_DATA_STATUS,&gBattleMons[target].status1);
+            result|=8;
+        }
+    }
+    if (gBattleMons[target].ability != ABILITY_SHIELD_DUST
+        && (move == MOVE_AURORA_BEAM || move == MOVE_ACID || move == MOVE_BITE || move == MOVE_ASTONISH
+            || move == MOVE_MUD_SLAP || move == MOVE_MUD_SHOT || move == MOVE_BUBBLE || move == MOVE_ROCK_TOMB || move == MOVE_ICY_WIND
+            || move == MOVE_PSYCHIC || move == MOVE_SHADOW_BALL || move == MOVE_CRUNCH)
+        && Random() % 100 < gBattleMoves[move].secondaryEffectChance)
+    {
+        if (move == MOVE_AURORA_BEAM || move == MOVE_ACID || move == MOVE_MUD_SLAP || move == MOVE_MUD_SHOT || move == MOVE_BUBBLE || move == MOVE_ROCK_TOMB || move == MOVE_ICY_WIND
+            || move == MOVE_PSYCHIC || move == MOVE_SHADOW_BALL || move == MOVE_CRUNCH)
+        {
+            ChangeStatBuffs(SET_STAT_BUFF_VALUE(1) | STAT_BUFF_NEGATIVE, stat, 0, NULL);
+            if (gBattleMons[target].statStages[stat] < before) result |= 1;
+        }
+        else if (gBattleMons[target].ability != ABILITY_INNER_FOCUS)
+            result |= 2;
+    }
+    // Same conditions/type mutation as native Color Change. Battle-only types
+    // remain in gBattleMons for a classic handoff, never in the saved Pokemon.
+    if (gBattleMons[target].ability == ABILITY_COLOR_CHANGE
+        && move != MOVE_STRUGGLE && gBattleMoves[move].power
+        && !IS_BATTLER_OF_TYPE(target, gBattleMoves[move].type))
+    {
+        SET_BATTLER_TYPE(target, gBattleMoves[move].type);
+        result |= 4;
+    }
+    gBattlescriptCurrInstr = savedScript;
+    return result;
+}
+
+// A bounded synchronous adapter for a PRIMARY Defense-down action. Eligible
+// arena battlers have no Protect or Mist;
+// keep those encounters on the original battle script until separately tested.
+// Shield Dust must not block a primary stat move: use the same flag as Leer.
+s8 RealtimeArena_StatChange(u16 move, u8 *stat, bool8 *self)
+{
+    *self = FALSE;
+    switch (move)
+    {
+    case MOVE_LEER: case MOVE_TAIL_WHIP: *stat=STAT_DEF; return -1;
+    case MOVE_GROWL: *stat=STAT_ATK; return -1;
+    case MOVE_SAND_ATTACK: *stat=STAT_ACC; return -1;
+    case MOVE_STRING_SHOT: *stat=STAT_SPEED; return -1;
+    case MOVE_SCREECH: *stat=STAT_DEF; return -2;
+    }
+    *self = TRUE;
+    switch (move)
+    {
+    case MOVE_HARDEN: case MOVE_DEFENSE_CURL: *stat=STAT_DEF; return 1;
+    case MOVE_HOWL: *stat=STAT_ATK; return 1;
+    case MOVE_GROWTH: *stat=STAT_SPATK; return 1;
+    case MOVE_AGILITY: *stat=STAT_SPEED; return 2;
+    }
+    return 0;
+}
+
+bool8 RealtimeArena_ResolveLeer(u8 attacker, u8 target)
+{
+    return RealtimeArena_ResolveStatMove(attacker,target,MOVE_LEER);
+}
+
+bool8 RealtimeArena_ResolveStatMove(u8 attacker, u8 target, u16 move)
+{
+    const u8 *savedScript = gBattlescriptCurrInstr;
+    u8 scratch[16] = {0};
+    u32 failure = (u32)(scratch + 7);
+    u8 stat=STAT_ATK, before, affected, savedStack=gBattleResources->battleScriptsStack->size;
+    bool8 self;
+    s8 delta=RealtimeArena_StatChange(move,&stat,&self);
+    bool8 worked=FALSE;
+    if(move==MOVE_FOCUS_ENERGY)
+    {
+        worked=!(gBattleMons[attacker].status2&STATUS2_FOCUS_ENERGY);
+        gBattleMons[attacker].status2|=STATUS2_FOCUS_ENERGY;
+        if(attacker==0)gBattleResults.lastUsedMovePlayer=move;
+        else gBattleResults.lastUsedMoveOpponent=move;
+        return worked;
+    }
+    if(!delta)return FALSE;
+    affected=self?attacker:target;
+    before=gBattleMons[affected].statStages[stat];
+    gBattlerAttacker = attacker;
+    gBattlerTarget = target;
+    gCurrentMove = move;
+    gMoveResultFlags = 0;
+    scratch[1] = failure; scratch[2] = failure >> 8;
+    scratch[3] = failure >> 16; scratch[4] = failure >> 24;
+    gBattlescriptCurrInstr = scratch;
+    if(!self)Cmd_accuracycheck();
+    if (!(gMoveResultFlags & MOVE_RESULT_NO_EFFECT))
+    {
+        ChangeStatBuffs(SET_STAT_BUFF_VALUE(delta<0?-delta:delta) | (delta<0?STAT_BUFF_NEGATIVE:0),
+                       stat, STAT_CHANGE_ALLOW_PTR | (self?MOVE_EFFECT_AFFECTS_USER:0), scratch + 7);
+        if(move==MOVE_DEFENSE_CURL)gBattleMons[attacker].status2|=STATUS2_DEFENSE_CURL;
+    }
+    if (attacker == 0) gBattleResults.lastUsedMovePlayer = move;
+    else gBattleResults.lastUsedMoveOpponent = move;
+    gBattlescriptCurrInstr = savedScript;
+    // Keen Eye's original rejection can push presentation text; its native
+    // prevention is retained, but the arena supplies its own brief feedback.
+    gBattleResources->battleScriptsStack->size=savedStack;
+    return gBattleMons[affected].statStages[stat] != before;
+}
+
+u16 RealtimeArena_DrainAmount(u16 hpDealt)
+{
+    const u8 *savedScript = gBattlescriptCurrInstr;
+    u8 scratch[2] = {0};
+    u16 result;
+    if (!hpDealt) return 0;
+    gHpDealt = hpDealt;
+    gBattlescriptCurrInstr = scratch;
+    Cmd_negativedamage();
+    result = -gBattleMoveDamage;
+    gBattlescriptCurrInstr = savedScript;
+    return result;
+}
